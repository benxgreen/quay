{
	"name": "quay",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:up": "docker compose up --detach --wait",
		"db:down": "docker compose down",
		"db:setup": "sh db/scripts/setup-local.sh",
		"db:migrate": "node --env-file=.env db/scripts/migrate.mjs",
		"db:reset": "docker compose down --volumes && npm run db:up && npm run db:setup && npm run db:migrate && npm run db:seed",
		"db:seed": "node --env-file=.env db/scripts/seed-dev.mjs"
	},
	"dependencies": {
		"better-auth": "^1.7.14",
		"next": "^16.4.3",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/nextjs-vite": "^10.6.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"axe-core": "^4.14.0",
		"jsdom": "^30.1.3",
		"storybook": "^10.6.5",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
