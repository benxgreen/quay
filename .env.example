# Copy to .env and fill in. .env is gitignored.

# Docker Compose: the local Postgres superuser (stands in for the Azure admin)
POSTGRES_PASSWORD=

# Passwords given to the roles by db/setup/00_roles_and_database.sql
PORTAL_MIGRATOR_PASSWORD=
PORTAL_APP_PASSWORD=

# Migrations: portal_migrator, direct to Postgres on 5432 (never PgBouncer).
# On Azure add ?sslmode=require.
MIGRATE_DATABASE_URL=postgres://portal_migrator:<password>@localhost:5432/quay

# The app: portal_app through PgBouncer on 6432. On Azure add ?sslmode=require.
DATABASE_URL=postgres://portal_app:<password>@localhost:6432/quay

# Sign-in: Better Auth, cookie-only sessions. Generate the secret with
# openssl rand -base64 48. BETTER_AUTH_URL is the portal's own address.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# AUTH_MODE=dev forces the development sign-in at /auth/dev even when the
# ENTRA_* values are set (never in production).
# AUTH_MODE=entra
# The portal's address for links in emails. Defaults to BETTER_AUTH_URL.
# PORTAL_URL=https://quay.internal.bcpcouncil.gov.uk
# Signs the case links in emails. Defaults to BETTER_AUTH_SECRET; set its
# own value so rotating the sign-in secret doesn't break old email links.
# CASE_LINK_SECRET=
# Microsoft Entra ID app registration. Until these are set, outside
# production the development sign-in is used instead (AUTH_MODE=dev|entra
# to choose). Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/microsoft
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=

# External clients: mock (default) until the real details arrive, or http.
# HALO_CLIENT=http uses the Halo API for staff details; laptop replacements'
# Halo calls are still mock only and refuse http.
# HALO_CLIENT=mock
# The Halo API application (Configuration › Integrations › Halo API), client
# credentials. The Halo site URL is in Settings › Connections, not here.
# HALO_CLIENT_ID=
# HALO_CLIENT_SECRET=
# HALO_SCOPE=all
# EMAIL_CLIENT=mock
# Make these mock connections fail, to see the Failed banner:
# MOCK_FAILURES=halo,email_webhook

# Optional: work offline with fixed bank holidays instead of the GOV.UK feed.
# BANK_HOLIDAYS_SOURCE=mock
# BANK_HOLIDAYS_MOCK=2026-12-25,2026-12-28

# Scheduled jobs: the timer calls POST /api/replacements/laptops/jobs at 9am
# with "Authorization: Bearer <JOBS_SECRET>". Generate with
# openssl rand -base64 48.
JOBS_SECRET=
